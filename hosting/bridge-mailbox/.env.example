# Скопировать в .env НА СЕРВЕРЕ Timeweb (не коммитить .env).
# Файл → Открыть в блокноте на хостинге или залить через FTP один раз.
# Ключ: в PowerShell  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')

BRIDGE_KEY=замени_на_длинный_случайный_ключ

# Необязательное второе кольцо (HTTP Basic). Если пусто — не проверяется.
# BRIDGE_BASIC_USER=
# BRIDGE_BASIC_PASS=

MAX_BYTES=2097152
